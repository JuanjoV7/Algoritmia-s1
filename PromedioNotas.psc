Algoritmo PromedioNotas
	
	Definir Nota1, Nota2, Nota3, Promedio Como Real
	
	Escribir "Ingrese nota 1"
	Leer Nota1
	
	Escribir "Ingrese nota 2"
	Leer Nota2
	
	Escribir "Ingrese nota 3"
	Leer Nota3
	
	Promedio = (Nota1 + Nota2+ Nota3) / 3
	
	Escribir "El promedio es de: ", Promedio
	
	
FinAlgoritmo
